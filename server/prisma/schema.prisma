generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

model DeliveryAgent {
  id          String      @id @default(uuid())
  name        String
  email       String      @unique
  phone       String      @unique
  serviceArea String
  status      AgentStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
