generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  AVAILABLE
  ON_DELIVERY
  INACTIVE
}

model DeliveryAgent {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  phone     String      @unique
  status    AgentStatus @default(AVAILABLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}
